# Rendered by the Nginx image entrypoint. Only defined environment variables
# are substituted (here ${NGINX_LOCAL_RESOLVERS}); Nginx variables such as
# $host are left untouched.

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # A prediction request is a short JSON body
    client_max_body_size 16k;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # Resolve "backend" through the container DNS at request time, so a
    # recreated backend container with a new IP address is found again
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend_upstream http://backend:8000;

    # The only API route exposed to the internet
    location = /api/predict {
        limit_except POST {
            deny all;
        }
        proxy_pass $backend_upstream/predict;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Everything else under /api (for example FastAPI /docs) stays private
    location /api/ {
        return 404;
    }

    # Vite puts content-hashed files in /assets, so they can be cached long
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
